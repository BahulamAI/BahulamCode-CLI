# Hosted OAuth mode is the default. Keep actual secrets in private mounted files.
CLIENT_ID=bot-app-client-id
CLIENT_SECRET=provision-through-secret-manager
TENANT_ID=bot-registration-tenant-id
BAHULAM_PLATFORM_URL=https://api.example.com
BAHULAM_ADO_BROKER_URL=https://broker.example.com/api/integration-connections/
BAHULAM_APP_URL=https://app.example.com
BAHULAM_INTEGRATION_SERVICE_TOKEN_FILE=/run/secrets/integration-service
BAHULAM_PLUGIN_DIR=/plugins/azure-devops
BAHULAM_ADO_PLUGIN_DIGEST=sha256:generated-from-immutable-plugin-files
BAHULAM_MODEL=configure-approved-model
PORT=3978
# Supply the runtime's model credential through the existing deployment secrets.
# Never set ADO PATs or OAuth refresh tokens in this process.
