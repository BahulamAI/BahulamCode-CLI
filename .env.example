# Bahulam Code — Environment Variables
# Copy to .env and fill in values as needed.

# ── Authentication ──────────────────────────────────────────
# Bahulam session token (set via `bahulam login`)
# B0_TOKEN=

# BYOK — bring your own API keys (optional, for local model usage)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# ── Backend ─────────────────────────────────────────────────
# Override the backend URL (defaults to api.bahulam.ai)
# TARANG_BACKEND_URL=

# Override the web dashboard URL (defaults to bahulam.ai)
# TARANG_WEB_URL=

# Override the gateway URL (defaults to gateway.bahulam.ai)
# BAHULAM_GATEWAY_URL=

# ── Environment ─────────────────────────────────────────────
# Runtime environment: production (default), local, bundled
# TARANG_ENV=production
# NODE_ENV=production

# Runtime mode for bundled Python subprocess
# BAHULAM_RUNTIME_MODE=

# ── Debug ───────────────────────────────────────────────────
# Enable MCP debug logging
# MCP_DEBUG=1

# Enable general debug output
# DEBUG=1

# ── Features ────────────────────────────────────────────────
# Block separator style: space (default), dotted, off
# BAHULAM_BLOCK_SEPARATOR=space

# Detect repeated tool calls and no-op edit loops
# BAHULAM_STAGNATION_DETECTION=0
# BAHULAM_STAGNATION_THRESHOLD=3

# ── Terminal UI ─────────────────────────────────────────────
# Terminal mode: rich (default), stable, transcript, plain
# BAHULAM_TTY_MODE=rich

# Disable ANSI output and the fixed input dock
# BAHULAM_PLAIN=0

# Disable only the fixed bottom input dock
# BAHULAM_FIXED_INPUT=1

# Maximum rows used by the fixed input dock
# BAHULAM_INPUT_ROWS_MAX=6

# Blank rows below the prompt when the fixed input dock is disabled
# BAHULAM_PROMPT_BOTTOM_PADDING=5

# Debounce window for non-bracketed multiline paste input
# BAHULAM_PASTE_FLUSH_MS=35

# Image generation model override
# BAHULAM_IMAGE_GENERATION_MODEL=

# Product identifier sent in API headers
# BAHULAM_PRODUCT=bahulam-code

# ── Web Search (optional) ──────────────────────────────────
# Brave Search API key (falls back to SearXNG)
# BRAVE_API_KEY=

# SearXNG instance URL (fallback if no Brave key)
# SEARXNG_URL=

# ── Misc ────────────────────────────────────────────────────
# Suppress legacy token migration notice
# B0_QUIET_MIGRATION=1
